
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean
  image         String?
  createdAt     DateTime
  updatedAt     DateTime
  sessions      Session[]
  accounts      Account[]

  //app's settings
  reminderOn      Boolean @default(true)
  reminderTime    String  @default("20:00")
  reminderChannel String  @default("email")
  weekStart       String  @default("mon")
  theme           String  @default("light")

  // your app's data
  habits Habit[]
  roadmaps Roadmap[] // Journey feature: every roadmap this user has generated (the page shows only the newest)

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@map("account")
  @@index([userId])
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
  @@index([identifier])
}

model Habit {
  id         Int        @id @default(autoincrement())
  name       String
  goal       String?
  period     String     @default("daily")
  color      String
  remindTime String?
  archived   Boolean    @default(false)
  createdAt  DateTime   @default(now())
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs       HabitLog[]

  @@index([userId])
}

model HabitLog {
  id      Int      @id @default(autoincrement())
  date    DateTime @db.Date
  habitId Int
  habit   Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@unique([habitId, date])
}



// ---------- Journey feature ----------

// A personal roadmap: an ordered list of steps the user works through one by one.
model Roadmap {
  id         Int           @id @default(autoincrement()) // numeric id, same style as Habit
  userId     String // owner; every read/write filters on this
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade) // deleting the account deletes its roadmaps
  title      String // short name Claude gives the roadmap
  sourceType String // where the input came from: "pdf" | "text" | "manual"
  createdAt  DateTime      @default(now()) // used to pick the most recent roadmap
  steps      RoadmapStep[] // the ordered steps of this roadmap

  @@index([userId, createdAt]) // fast "newest roadmap for this user" lookup
}

// One step of a roadmap. "Locked" is NOT stored: it is derived from the first incomplete step.
model RoadmapStep {
  id          Int       @id @default(autoincrement()) // numeric id
  roadmapId   Int // which roadmap this step belongs to
  roadmap     Roadmap   @relation(fields: [roadmapId], references: [id], onDelete: Cascade) // deleting a roadmap deletes its steps
  order       Int // 1-based position in the roadmap
  title       String // short action title
  description String? // optional one-or-two sentence detail
  completed   Boolean   @default(false) // has the user finished this step?
  completedAt DateTime? // when it was finished (null while not done)

  @@unique([roadmapId, order]) // two steps can't share a position in the same roadmap
}
