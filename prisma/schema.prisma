generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean
  image         String?
  createdAt     DateTime
  updatedAt     DateTime
  sessions      Session[]
  accounts      Account[]

  //app's settings
  reminderOn      Boolean @default(true)
  reminderTime    String  @default("20:00")
  reminderChannel String  @default("email")
  weekStart       String  @default("mon")
  theme           String  @default("light")
  timeZone        String  @default("UTC") // IANA zone (e.g. "Africa/Tunis"), saved from the browser when notifications are turned on

  // your app's data
  habits            Habit[]
  pushSubscriptions PushSubscription[] // one per device that turned notifications on
  roadmaps          Roadmap[] // Journey feature: every roadmap this user has generated (the page shows only the newest)

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@index([identifier])
  @@map("verification")
}

model Habit {
  id             Int        @id @default(autoincrement())
  name           String
  goal           String?
  period         String     @default("daily")
  color          String
  remindTime     String?
  archived       Boolean    @default(false)
  lastRemindedOn DateTime?  @db.Date // user's local date of the last reminder sent, so each habit is reminded at most once a day
  createdAt      DateTime   @default(now())
  userId         String
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs           HabitLog[]

  @@index([userId])
}

model HabitLog {
  id      Int      @id @default(autoincrement())
  date    DateTime @db.Date
  habitId Int
  habit   Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@unique([habitId, date])
}

// ---------- Journey feature ----------

// A personal roadmap: an ordered list of steps the user works through one by one.
model Roadmap {
  id         Int           @id @default(autoincrement()) // numeric id, same style as Habit
  userId     String // owner; every read/write filters on this
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade) // deleting the account deletes its roadmaps
  title      String // short name Claude gives the roadmap
  sourceType String // where the input came from: "pdf" | "text" | "manual"
  createdAt  DateTime      @default(now()) // used to pick the most recent roadmap
  steps      RoadmapStep[] // the ordered steps of this roadmap

  @@index([userId, createdAt]) // fast "newest roadmap for this user" lookup
}

// One step of a roadmap. "Locked" is NOT stored: it is derived from the first incomplete step.
model RoadmapStep {
  id          Int       @id @default(autoincrement()) // numeric id
  roadmapId   Int // which roadmap this step belongs to
  roadmap     Roadmap   @relation(fields: [roadmapId], references: [id], onDelete: Cascade) // deleting a roadmap deletes its steps
  order       Int // 1-based position in the roadmap
  title       String // short action title
  description String? // optional one-or-two sentence detail
  completed   Boolean   @default(false) // has the user finished this step?
  completedAt DateTime? // when it was finished (null while not done)

  @@unique([roadmapId, order]) // two steps can't share a position in the same roadmap
}

// ---------- Push notifications ----------

// A browser/device that agreed to receive push notifications for this user.
model PushSubscription {
  id        Int      @id @default(autoincrement())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique // the push service URL for this device (unique per device + browser)
  p256dh    String // public encryption key from the browser
  auth      String // auth secret from the browser
  createdAt DateTime @default(now())

  @@index([userId])
}
