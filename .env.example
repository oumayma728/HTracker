# Copy this file to .env and fill in the values. Never commit .env.

# PostgreSQL connection string (e.g. from your Neon project: Connection Details)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Better Auth: a long random secret (generate with: openssl rand -base64 32)
BETTER_AUTH_SECRET=""
# The URL the app runs at (http://localhost:3000 locally, your live URL in production)
BETTER_AUTH_URL="http://localhost:3000"

# Anthropic API key, used by the Journey feature to generate roadmaps (server-side only)
ANTHROPIC_API_KEY=""
